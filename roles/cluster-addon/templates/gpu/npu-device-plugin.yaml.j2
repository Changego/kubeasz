# NPU Device Plugin DaemonSet（华为昇腾）
# 适配 kubeasz 的 Jinja2 模板变量
# 注意: 此 DaemonSet 运行需要节点有 huawei.com/npu=true 标签
#       该标签由 roles/gpu-node/tasks/npu.yml 自动打标，与 nodeSelector 保持一致
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: npu-device-plugin-daemonset
  namespace: kube-system
  labels:
    app: npu-device-plugin
spec:
  selector:
    matchLabels:
      name: npu-device-plugin-ds
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        name: npu-device-plugin-ds
        app: npu-device-plugin
    spec:
      tolerations:
        - key: huawei.com/npu
          operator: Exists
          effect: NoSchedule
        - key: node-role.kubernetes.io/master
          effect: NoSchedule
        - key: node-role.kubernetes.io/control-plane
          effect: NoSchedule
      priorityClassName: system-node-critical
      # 仅调度到有 NPU 的节点（与 npu.yml 中打的标签保持一致）
      nodeSelector:
        huawei.com/npu: "true"
      containers:
        - image: {{ npu_device_plugin_image }}
          name: npu-device-plugin-ctr
          resources:
            limits:
              memory: "300Mi"
              cpu: "500m"
            requests:
              memory: "300Mi"
              cpu: "500m"
          securityContext:
            privileged: true
          volumeMounts:
            - name: device-plugin
              mountPath: /var/lib/kubelet/device-plugins
            - name: dev
              mountPath: /dev
            - name: npusmi
              mountPath: /usr/local/bin/npu-smi
              readOnly: true
      volumes:
        - name: device-plugin
          hostPath:
            path: /var/lib/kubelet/device-plugins
        - name: dev
          hostPath:
            path: /dev
        - name: npusmi
          hostPath:
            path: /usr/local/bin/npu-smi
            type: FileOrCreate
